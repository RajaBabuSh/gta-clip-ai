# ====================================================================
# GTA CLIP AI - Git Ignore Policy
# Strictly prevents leaks of credentials, tokens, video media & dumps
# ====================================================================

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local

# Allow safe example templates
!.env.example
!.env.production.example
!backend/.env.example
!frontend/.env.example

# Credentials, Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
test_cookie.txt
*.cookie
*.cookies
oauth_key*

# Storage, Uploads, Cache & Generated Media Files (CRITICAL)
storage/
backend/storage/
storage/*
backend/storage/*
/storage
/backend/storage

# Raw Video and Audio Files
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.flv
*.wmv
*.m4a
*.mp3
*.wav
*.aac
*.ogg
*.m3u8
*.m2ts
*.mts
storage/**/*.ts
backend/storage/**/*.ts

# Backup Directories and Files
backups/
/backups
*.bak
*.backup
*.old
*.orig
*.swp
*.swo

# Database Dumps & SQLite DBs
*.sql.gz
*.sql.tar.gz
*.dump
*.db
*.sqlite
*.sqlite3
database/dumps/
database/backups/

# Python & AI Worker Virtual Environments
venv/
.venv/
env/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Node.js & Next.js Frontend
node_modules/
**/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.vercel
*.tsbuildinfo
frontend/next-env.d.ts

# Logs and Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
