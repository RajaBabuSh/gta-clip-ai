# ====================================================================
# GTA CLIP AI - Master Environment Configuration Template
# ====================================================================

# Backend Configuration
BACKEND_ENVIRONMENT=development
BACKEND_PORT=8000
BACKEND_HOST=127.0.0.1

# MySQL Database Connection (Local XAMPP / MariaDB / MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=gtaclipai

# Hardware Acceleration (Windows 11 / NVIDIA RTX 3050 6GB VRAM)
USE_NVIDIA_GPU=true
USE_NVENC_ENCODING=true
WHISPER_DEVICE=auto
WHISPER_MODEL=base

# Storage Limits
STORAGE_DIR=./backend/storage
MAX_UPLOAD_SIZE_MB=500

# YouTube Ingestion (Phase 2 Modular)
YOUTUBE_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_STORAGE_URL=http://localhost:8000/storage
