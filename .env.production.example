# ==============================================================================
# GTA CLIP AI - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application URLs
APP_NAME="GTA Clip AI"
APP_ENV=production
APP_URL=https://gtaclip.ai
FRONTEND_URL=https://gtaclip.ai

# Production MySQL Database Connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gtaclipai
MYSQL_USER=gtaclip_user
MYSQL_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD

# Decoupled AI Microservice & GPU Worker
# Point to your deployed FastAPI backend (e.g. Vercel microservice or dedicated server)
AI_WORKER_URL=https://gta-clip-ai.vercel.app
AI_WORKER_API_TOKEN=YOUR_GENERATED_API_BEARER_TOKEN
AI_WORKER_TIMEOUT=300

# Google Cloud OAuth 2.0 (YouTube Upload Integration)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://gtaclip.ai/api/youtube/callback.php

# Cloud AI & Media APIs (Optional / Free Tiers)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
PEXELS_API_KEY=YOUR_PEXELS_API_KEY

# Storage Drivers: local or r2 (Cloudflare Object Storage)
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gtaclip-media
R2_PUBLIC_URL=https://media.gtaclip.ai
