# ===================================================
# GTA CLIP AI - Backend Environment Configuration
# ===================================================

# Application
ENVIRONMENT=development
PROJECT_NAME="GTA CLIP AI"
API_V1_STR=/api/v1
PORT=8000
HOST=127.0.0.1

# MySQL Database (Local XAMPP / MariaDB / MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=gtaclipai

# Storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=500

# Hardware Acceleration (NVIDIA RTX 3050 Laptop GPU)
USE_NVIDIA_GPU=true
USE_NVENC_ENCODING=true
WHISPER_DEVICE=auto
WHISPER_MODEL=base

# YouTube Integration (Modular Authorized Ingestion)
YOUTUBE_API_KEY=
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
